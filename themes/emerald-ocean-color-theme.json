    "titleBar.activeBackground": "#001c12",
    "titleBar.activeForeground": "#cbdbdf",
    "titleBar.inactiveBackground": "#001c12",
    "titleBar.inactiveForeground": "#8ca59a",
    "titleBar.border": "#001c12",
    "statusBar.background": "#001c12",
    "statusBar.foreground": "#cbdbdf",
    "statusBar.border": "#001c12",
    "statusBar.noFolderBackground": "#001c12",
    "statusBar.debuggingBackground": "#f7a792",
    "statusBar.debuggingForeground": "#01130b",
    "statusBarItem.remoteBackground": "#83eab5",
    "statusBarItem.remoteForeground": "#01130b",
    "statusBarItem.hoverBackground": "#02291c",
    "statusBarItem.errorForeground": "#df676b",
    "statusBarItem.warningForeground": "#f7a792",
    "panel.background": "#001c12",
    "panel.border": "#405d50",
    "panelTitle.activeForeground": "#cbdbdf",
    "panelTitle.activeBorder": "#83eab5",
    "panelTitle.inactiveForeground": "#8ca59a",
    "input.background": "#02291c",
    "input.foreground": "#cbdbdf",
    "input.border": "#405d50",
    "input.placeholderForeground": "#8ca59a",
    "inputOption.activeBorder": "#76dffb",
    "inputOption.activeBackground": "#76dffb33",
    "dropdown.background": "#02291c",
    "dropdown.border": "#405d50",
    "dropdown.foreground": "#cbdbdf",
    "button.background": "#83eab5",
    "button.foreground": "#01130b",
    "button.hoverBackground": "#76dffb",
    "button.secondaryBackground": "#405d50",
    "button.secondaryForeground": "#eceff1",
    "checkbox.background": "#02291c",
    "checkbox.border": "#405d50",
    "quickInput.background": "#001c12",
    "quickInput.foreground": "#cbdbdf",
    "quickInputList.focusBackground": "#02291c",
    "pickerGroup.foreground": "#83eab5",
    "pickerGroup.border": "#405d50",
    "keybindingLabel.foreground": "#cbdbdf",
    "keybindingLabel.background": "#02291c",
    "keybindingLabel.border": "#405d50",
    "notifications.background": "#001c12",
    "notifications.foreground": "#cbdbdf",
    "notifications.border": "#405d50",
    "notificationsErrorIcon.foreground": "#df676b",
    "notificationsWarningIcon.foreground": "#f7a792",
    "notificationsInfoIcon.foreground": "#76dffb",
    "scrollbarSlider.background": "#405d5066",
    "scrollbarSlider.hoverBackground": "#405d5099",
    "scrollbarSlider.activeBackground": "#405d50",
    "minimap.findMatchHighlight": "#76dffb",
    "minimap.selectionHighlight": "#02291c",
    "minimap.errorHighlight": "#df676b",
    "minimap.warningHighlight": "#f7a792",
    "gitDecoration.addedResourceForeground": "#83eab5",
    "gitDecoration.modifiedResourceForeground": "#76dffb",
    "gitDecoration.deletedResourceForeground": "#df676b",
    "gitDecoration.untrackedResourceForeground": "#97c37f",
    "gitDecoration.ignoredResourceForeground": "#405d50",
    "gitDecoration.conflictingResourceForeground": "#f7a792",
    "terminal.background": "#01130b",
    "terminal.foreground": "#cbdbdf",
    "terminalCursor.foreground": "#76dffb",
    "terminal.selectionBackground": "#02291c",
    "terminal.ansiBlack": "#001c12",
    "terminal.ansiRed": "#df676b",
    "terminal.ansiGreen": "#83eab5",
    "terminal.ansiYellow": "#f7a792",
    "terminal.ansiBlue": "#5b92bf",
    "terminal.ansiMagenta": "#baa4e2",
    "terminal.ansiCyan": "#76dffb",
    "terminal.ansiWhite": "#cbdbdf",
    "terminal.ansiBrightBlack": "#405d50",
    "terminal.ansiBrightRed": "#df676b",
    "terminal.ansiBrightGreen": "#83eab5",
    "terminal.ansiBrightYellow": "#f7a792",
    "terminal.ansiBrightBlue": "#5b92bf",
    "terminal.ansiBrightMagenta": "#baa4e2",
    "terminal.ansiBrightCyan": "#76dffb",
    "terminal.ansiBrightWhite": "#eceff1",
    "debugToolBar.background": "#001c12",
    "debugIcon.breakpointForeground": "#df676b",
    "editor.stackFrameHighlightBackground": "#76dffb33",
    "textLink.foreground": "#5b92bf",
    "textLink.activeForeground": "#76dffb",
    "textPreformat.foreground": "#eceff1",
    "textBlockQuote.background": "#001c12",
    "textBlockQuote.border": "#405d50"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8ca59a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "TODO",
      "scope": [
        "comment.line.todo",
        "keyword.todo"
      ],
      "settings": {
        "foreground": "#f7a792"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#eceff1"
      }
    },
    {
      "name": "Escapes and format verbs",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp",
        "punctuation.definition.template-expression",
        "constant.character.format"
      ],
      "settings": {
        "foreground": "#76dffb"
      }
    },
    {
      "name": "Numbers, booleans, nil, constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f7a792"
      }
    },
    {
      "name": "Keywords and builtin types",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type.primitive",
        "support.type.builtin",
        "variable.language"
      ],
      "settings": {
        "foreground": "#97c37f"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#8ca59a"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#83eab5"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7bd3cf"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cbdbdf"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#cbdbdf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Fields and properties",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "meta.property",
        "support.variable.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#5b92bf"
      }
    },
    {
      "name": "Packages and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "entity.name.import",
        "support.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#5b92bf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Macros, attributes, decorators",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#baa4e2"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7bd3cf"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5b92bf"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#83eab5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5b92bf"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8ca59a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list",
        "markup.list"
      ],
      "settings": {
        "foreground": "#97c37f"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#83eab5"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#df676b"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#76dffb"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#df676b"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#5b92bf",
      "italic": true
    },
    "type": "#7bd3cf",
    "class": "#7bd3cf",
    "struct": "#7bd3cf",
    "interface": "#7bd3cf",
    "enum": "#7bd3cf",
    "typeParameter": "#7bd3cf",
    "type.defaultLibrary": "#97c37f",
    "type.declaration": "#eceff1",
    "type.definition": "#eceff1",
    "class.declaration": "#eceff1",
    "struct.declaration": "#eceff1",
    "interface.declaration": "#eceff1",
    "parameter": {
      "foreground": "#cbdbdf",
      "italic": true
    },
    "variable": "#cbdbdf",
    "variable.readonly": "#f7a792",
    "property": "#5b92bf",
    "property.declaration": "#eceff1",
    "property.definition": "#eceff1",
    "enumMember": "#f7a792",
    "function": "#83eab5",
    "method": "#83eab5",
    "function.defaultLibrary": "#83eab5",
    "macro": "#baa4e2",
    "decorator": "#baa4e2",
    "keyword": "#97c37f",
    "comment": {
      "foreground": "#8ca59a",
      "italic": true
    },
    "string": "#eceff1",
    "number": "#f7a792",
    "operator": "#8ca59a"
  }
}
