    "editorGroupHeader.tabsBackground": "#001c12",
    "editorGroup.border": "#02291c",
    "tab.activeBackground": "#01130b",
    "tab.activeForeground": "#cbdbdf",
    "tab.activeBorderTop": "#83eab5",
    "tab.inactiveBackground": "#001c12",
