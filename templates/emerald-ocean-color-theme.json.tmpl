{
  "$schema": "vscode://schemas/color-theme",
  "name": "Emerald Ocean",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "{{.glow}}",
    "foreground": "{{.foam}}",
    "descriptionForeground": "{{.silt}}",
    "errorForeground": "{{.urchin}}",
    "icon.foreground": "{{.foam}}",
    "widget.border": "{{.shoal}}",
    "selection.background": "{{.current}}",
    "editor.background": "{{.abyss}}",
    "editor.foreground": "{{.foam}}",
    "editorCursor.foreground": "{{.glow}}",
    "editor.lineHighlightBackground": "{{.trench}}",
    "editor.lineHighlightBorder": "{{.trench}}",
    "editor.selectionBackground": "{{.current}}",
    "editor.inactiveSelectionBackground": "{{alpha .current 0.60}}",
    "editor.selectionHighlightBackground": "{{alpha .glow 0.10}}",
    "editor.findMatchBackground": "{{.glow}}",
    "editor.findMatchForeground": "{{.abyss}}",
    "editor.findMatchHighlightBackground": "{{alpha .glow 0.16}}",
    "editor.findRangeHighlightBackground": "{{.trench}}",
    "editor.wordHighlightBackground": "{{alpha .glow 0.20}}",
    "editor.wordHighlightStrongBackground": "{{alpha .glow 0.20}}",
    "editor.hoverHighlightBackground": "{{alpha .glow 0.10}}",
    "editor.rangeHighlightBackground": "{{.trench}}",
    "editorBracketMatch.background": "{{alpha .glow 0.20}}",
    "editorBracketMatch.border": "{{.glow}}",
    "editorLineNumber.foreground": "{{.shoal}}",
    "editorLineNumber.activeForeground": "{{.foam}}",
    "editorWhitespace.foreground": "{{.shoal}}",
    "editorIndentGuide.background1": "{{alpha .shoal 0.40}}",
    "editorIndentGuide.activeBackground1": "{{.shoal}}",
    "editorRuler.foreground": "{{.trench}}",
    "editorCodeLens.foreground": "{{.silt}}",
    "editorInlayHint.foreground": "{{.silt}}",
    "editorInlayHint.background": "#00000000",
    "editorLink.activeForeground": "{{.tide}}",
    "editorGutter.background": "{{.abyss}}",
    "editorGutter.addedBackground": "{{.emerald}}",
    "editorGutter.modifiedBackground": "{{.glow}}",
    "editorGutter.deletedBackground": "{{.urchin}}",
    "editorError.foreground": "{{.urchin}}",
    "editorWarning.foreground": "{{.coral}}",
    "editorInfo.foreground": "{{.glow}}",
    "editorHint.foreground": "{{.emerald}}",
    "editorUnnecessaryCode.opacity": "#00000099",
    "editorOverviewRuler.border": "{{.abyss}}",
    "editorOverviewRuler.errorForeground": "{{.urchin}}",
    "editorOverviewRuler.warningForeground": "{{.coral}}",
    "editorOverviewRuler.infoForeground": "{{.glow}}",
    "editorOverviewRuler.findMatchForeground": "{{.glow}}",
    "editorOverviewRuler.addedForeground": "{{.emerald}}",
    "editorOverviewRuler.modifiedForeground": "{{.glow}}",
    "editorOverviewRuler.deletedForeground": "{{.urchin}}",
    "editorWidget.background": "{{.trench}}",
    "editorWidget.foreground": "{{.foam}}",
    "editorWidget.border": "{{.shoal}}",
    "editorHoverWidget.background": "{{.trench}}",
    "editorHoverWidget.border": "{{.shoal}}",
    "editorSuggestWidget.background": "{{.current}}",
    "editorSuggestWidget.border": "{{.shoal}}",
    "editorSuggestWidget.foreground": "{{.foam}}",
    "editorSuggestWidget.selectedBackground": "{{.shoal}}",
    "editorSuggestWidget.selectedForeground": "{{.white}}",
    "editorSuggestWidget.highlightForeground": "{{.glow}}",
    "editorSuggestWidget.focusHighlightForeground": "{{.glow}}",
    "editorGhostText.foreground": "{{.shoal}}",
    "peekView.border": "{{.shoal}}",
    "peekViewTitle.background": "{{.trench}}",
    "peekViewTitleLabel.foreground": "{{.emerald}}",
    "peekViewTitleDescription.foreground": "{{.silt}}",
    "peekViewEditor.background": "{{.trench}}",
    "peekViewEditor.matchHighlightBackground": "{{alpha .glow 0.20}}",
    "peekViewResult.background": "{{.trench}}",
    "peekViewResult.selectionBackground": "{{.current}}",
    "peekViewResult.matchHighlightBackground": "{{alpha .glow 0.20}}",
    "diffEditor.insertedTextBackground": "{{alpha .emerald 0.15}}",
    "diffEditor.removedTextBackground": "{{alpha .urchin 0.15}}",
    "diffEditor.insertedLineBackground": "{{alpha .emerald 0.10}}",
    "diffEditor.removedLineBackground": "{{alpha .urchin 0.10}}",
    "activityBar.background": "{{.trench}}",
    "activityBar.foreground": "{{.foam}}",
    "activityBar.inactiveForeground": "{{.silt}}",
    "activityBar.activeBorder": "{{.emerald}}",
    "activityBar.border": "{{.trench}}",
    "activityBarBadge.background": "{{.glow}}",
    "activityBarBadge.foreground": "{{.abyss}}",
    "badge.background": "{{.glow}}",
    "badge.foreground": "{{.abyss}}",
    "sideBar.background": "{{.trench}}",
    "sideBar.foreground": "{{.foam}}",
    "sideBar.border": "{{.trench}}",
    "sideBarTitle.foreground": "{{.foam}}",
    "sideBarSectionHeader.background": "{{.trench}}",
    "sideBarSectionHeader.foreground": "{{.foam}}",
    "sideBarSectionHeader.border": "{{.current}}",
    "list.activeSelectionBackground": "{{.current}}",
    "list.activeSelectionForeground": "{{.white}}",
    "list.inactiveSelectionBackground": "{{.current}}",
    "list.hoverBackground": "{{alpha .current 0.60}}",
    "list.focusOutline": "{{.glow}}",
    "list.highlightForeground": "{{.glow}}",
    "list.errorForeground": "{{.urchin}}",
    "list.warningForeground": "{{.coral}}",
    "tree.indentGuidesStroke": "{{.shoal}}",
    "editorGroupHeader.tabsBackground": "{{.trench}}",
    "editorGroup.border": "{{.current}}",
    "tab.activeBackground": "{{.abyss}}",
    "tab.activeForeground": "{{.foam}}",
    "tab.activeBorderTop": "{{.emerald}}",
    "tab.inactiveBackground": "{{.trench}}",
    "tab.inactiveForeground": "{{.silt}}",
    "tab.border": "{{.trench}}",
    "tab.hoverBackground": "{{.current}}",
    "breadcrumb.foreground": "{{.silt}}",
    "breadcrumb.focusForeground": "{{.foam}}",
    "breadcrumb.activeSelectionForeground": "{{.glow}}",
    "titleBar.activeBackground": "{{.trench}}",
    "titleBar.activeForeground": "{{.foam}}",
    "titleBar.inactiveBackground": "{{.trench}}",
    "titleBar.inactiveForeground": "{{.silt}}",
    "titleBar.border": "{{.trench}}",
    "statusBar.background": "{{.trench}}",
    "statusBar.foreground": "{{.foam}}",
    "statusBar.border": "{{.trench}}",
    "statusBar.noFolderBackground": "{{.trench}}",
    "statusBar.debuggingBackground": "{{.coral}}",
    "statusBar.debuggingForeground": "{{.abyss}}",
    "statusBarItem.remoteBackground": "{{.emerald}}",
    "statusBarItem.remoteForeground": "{{.abyss}}",
    "statusBarItem.hoverBackground": "{{.current}}",
    "statusBarItem.errorForeground": "{{.urchin}}",
    "statusBarItem.warningForeground": "{{.coral}}",
    "panel.background": "{{.trench}}",
    "panel.border": "{{.shoal}}",
    "panelTitle.activeForeground": "{{.foam}}",
    "panelTitle.activeBorder": "{{.emerald}}",
    "panelTitle.inactiveForeground": "{{.silt}}",
    "input.background": "{{.current}}",
    "input.foreground": "{{.foam}}",
    "input.border": "{{.shoal}}",
    "input.placeholderForeground": "{{.silt}}",
    "inputOption.activeBorder": "{{.glow}}",
    "inputOption.activeBackground": "{{alpha .glow 0.20}}",
    "dropdown.background": "{{.current}}",
    "dropdown.border": "{{.shoal}}",
    "dropdown.foreground": "{{.foam}}",
    "button.background": "{{.emerald}}",
    "button.foreground": "{{.abyss}}",
    "button.hoverBackground": "{{.glow}}",
    "button.secondaryBackground": "{{.shoal}}",
    "button.secondaryForeground": "{{.white}}",
    "checkbox.background": "{{.current}}",
    "checkbox.border": "{{.shoal}}",
    "quickInput.background": "{{.trench}}",
    "quickInput.foreground": "{{.foam}}",
    "quickInputList.focusBackground": "{{.current}}",
    "pickerGroup.foreground": "{{.emerald}}",
    "pickerGroup.border": "{{.shoal}}",
    "keybindingLabel.foreground": "{{.foam}}",
    "keybindingLabel.background": "{{.current}}",
    "keybindingLabel.border": "{{.shoal}}",
    "notifications.background": "{{.trench}}",
    "notifications.foreground": "{{.foam}}",
    "notifications.border": "{{.shoal}}",
    "notificationsErrorIcon.foreground": "{{.urchin}}",
    "notificationsWarningIcon.foreground": "{{.coral}}",
    "notificationsInfoIcon.foreground": "{{.glow}}",
    "scrollbarSlider.background": "{{alpha .shoal 0.40}}",
    "scrollbarSlider.hoverBackground": "{{alpha .shoal 0.60}}",
    "scrollbarSlider.activeBackground": "{{.shoal}}",
    "minimap.findMatchHighlight": "{{.glow}}",
    "minimap.selectionHighlight": "{{.current}}",
    "minimap.errorHighlight": "{{.urchin}}",
    "minimap.warningHighlight": "{{.coral}}",
    "gitDecoration.addedResourceForeground": "{{.emerald}}",
    "gitDecoration.modifiedResourceForeground": "{{.glow}}",
    "gitDecoration.deletedResourceForeground": "{{.urchin}}",
    "gitDecoration.untrackedResourceForeground": "{{.verdigris}}",
    "gitDecoration.ignoredResourceForeground": "{{.shoal}}",
    "gitDecoration.conflictingResourceForeground": "{{.coral}}",
    "terminal.background": "{{.abyss}}",
    "terminal.foreground": "{{.foam}}",
    "terminalCursor.foreground": "{{.glow}}",
    "terminal.selectionBackground": "{{.current}}",
    "terminal.ansiBlack": "{{.trench}}",
    "terminal.ansiRed": "{{.urchin}}",
    "terminal.ansiGreen": "{{.emerald}}",
    "terminal.ansiYellow": "{{.coral}}",
    "terminal.ansiBlue": "{{.tide}}",
    "terminal.ansiMagenta": "{{.anemone}}",
    "terminal.ansiCyan": "{{.glow}}",
    "terminal.ansiWhite": "{{.foam}}",
    "terminal.ansiBrightBlack": "{{.shoal}}",
    "terminal.ansiBrightRed": "{{.urchin}}",
    "terminal.ansiBrightGreen": "{{.emerald}}",
    "terminal.ansiBrightYellow": "{{.coral}}",
    "terminal.ansiBrightBlue": "{{.tide}}",
    "terminal.ansiBrightMagenta": "{{.anemone}}",
    "terminal.ansiBrightCyan": "{{.glow}}",
    "terminal.ansiBrightWhite": "{{.white}}",
    "debugToolBar.background": "{{.trench}}",
    "debugIcon.breakpointForeground": "{{.urchin}}",
    "editor.stackFrameHighlightBackground": "{{alpha .glow 0.20}}",
    "textLink.foreground": "{{.tide}}",
    "textLink.activeForeground": "{{.glow}}",
    "textPreformat.foreground": "{{.white}}",
    "textBlockQuote.background": "{{.trench}}",
    "textBlockQuote.border": "{{.shoal}}"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "{{.silt}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "TODO",
      "scope": [
        "comment.line.todo",
        "keyword.todo"
      ],
      "settings": {
        "foreground": "{{.coral}}"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "{{.white}}"
      }
    },
    {
      "name": "Escapes and format verbs",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp",
        "punctuation.definition.template-expression",
        "constant.character.format"
      ],
      "settings": {
        "foreground": "{{.glow}}"
      }
    },
    {
      "name": "Numbers, booleans, nil, constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "{{.coral}}"
      }
    },
    {
      "name": "Keywords and builtin types",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type.primitive",
        "support.type.builtin",
        "variable.language"
      ],
      "settings": {
        "foreground": "{{.verdigris}}"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "{{.silt}}"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "{{.emerald}}"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "{{.seaglass}}"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "{{.foam}}"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "{{.foam}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Fields and properties",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "meta.property",
        "support.variable.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "{{.tide}}"
      }
    },
    {
      "name": "Packages and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "entity.name.import",
        "support.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "{{.tide}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Macros, attributes, decorators",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "{{.anemone}}"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "{{.seaglass}}"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "{{.tide}}"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "{{.emerald}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "{{.tide}}"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "{{.silt}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list",
        "markup.list"
      ],
      "settings": {
        "foreground": "{{.verdigris}}"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "{{.emerald}}"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "{{.urchin}}"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "{{.glow}}"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{{.urchin}}"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "{{.tide}}",
      "italic": true
    },
    "type": "{{.seaglass}}",
    "class": "{{.seaglass}}",
    "struct": "{{.seaglass}}",
    "interface": "{{.seaglass}}",
    "enum": "{{.seaglass}}",
    "typeParameter": "{{.seaglass}}",
    "type.defaultLibrary": "{{.verdigris}}",
    "type.declaration": "{{.white}}",
    "type.definition": "{{.white}}",
    "class.declaration": "{{.white}}",
    "struct.declaration": "{{.white}}",
    "interface.declaration": "{{.white}}",
    "parameter": {
      "foreground": "{{.foam}}",
      "italic": true
    },
    "variable": "{{.foam}}",
    "variable.readonly": "{{.coral}}",
    "property": "{{.tide}}",
    "property.declaration": "{{.white}}",
    "property.definition": "{{.white}}",
    "enumMember": "{{.coral}}",
    "function": "{{.emerald}}",
    "method": "{{.emerald}}",
    "function.defaultLibrary": "{{.emerald}}",
    "macro": "{{.anemone}}",
    "decorator": "{{.anemone}}",
    "keyword": "{{.verdigris}}",
    "comment": {
      "foreground": "{{.silt}}",
      "italic": true
    },
    "string": "{{.white}}",
    "number": "{{.coral}}",
    "operator": "{{.silt}}"
  }
}
