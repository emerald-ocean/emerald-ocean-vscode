    "panelTitle.inactiveForeground": "{{.foam2}}",
    "input.background": "{{.abyss4}}",
    "input.foreground": "{{.foam4}}",
    "input.border": "{{.abyss5}}",
    "input.placeholderForeground": "{{.foam2}}",
    "inputOption.activeBorder": "{{.emerald4}}",
    "inputOption.activeBackground": "{{.emerald1}}",
    "dropdown.background": "{{.abyss4}}",
    "dropdown.border": "{{.abyss5}}",
    "dropdown.foreground": "{{.foam4}}",
    "button.background": "{{.emerald4}}",
    "button.foreground": "{{.abyss1}}",
    "button.hoverBackground": "{{.emerald5}}",
    "button.secondaryBackground": "{{.abyss5}}",
    "button.secondaryForeground": "{{.foam5}}",
    "checkbox.background": "{{.abyss4}}",
    "checkbox.border": "{{.abyss5}}",
    "quickInput.background": "{{.abyss2}}",
    "quickInput.foreground": "{{.foam4}}",
    "quickInputList.focusBackground": "{{.abyss4}}",
    "pickerGroup.foreground": "{{.emerald4}}",
    "pickerGroup.border": "{{.abyss5}}",
    "keybindingLabel.foreground": "{{.foam4}}",
    "keybindingLabel.background": "{{.abyss4}}",
    "keybindingLabel.border": "{{.abyss5}}",
    "notifications.background": "{{.abyss2}}",
    "notifications.foreground": "{{.foam4}}",
    "notifications.border": "{{.abyss5}}",
    "notificationsErrorIcon.foreground": "{{.reef3}}",
    "notificationsWarningIcon.foreground": "{{.reef4}}",
    "notificationsInfoIcon.foreground": "{{.sea5}}",
    "scrollbarSlider.background": "{{alpha .abyss5 0.40}}",
    "scrollbarSlider.hoverBackground": "{{alpha .abyss5 0.60}}",
    "scrollbarSlider.activeBackground": "{{.abyss5}}",
    "minimap.findMatchHighlight": "{{.emerald4}}",
    "minimap.selectionHighlight": "{{.abyss4}}",
    "minimap.errorHighlight": "{{.reef3}}",
    "minimap.warningHighlight": "{{.reef4}}",
    "gitDecoration.addedResourceForeground": "{{.emerald4}}",
    "gitDecoration.modifiedResourceForeground": "{{.sea5}}",
    "gitDecoration.deletedResourceForeground": "{{.reef3}}",
    "gitDecoration.untrackedResourceForeground": "{{.kelp4}}",
    "gitDecoration.ignoredResourceForeground": "{{.abyss5}}",
    "gitDecoration.conflictingResourceForeground": "{{.reef4}}",
    "terminal.background": "{{.abyss1}}",
    "terminal.foreground": "{{.foam4}}",
    "terminalCursor.foreground": "{{.biolume4}}",
    "terminal.selectionBackground": "{{.abyss4}}",
    "terminal.ansiBlack": "{{.abyss2}}",
    "terminal.ansiRed": "{{.reef3}}",
    "terminal.ansiGreen": "{{.emerald4}}",
    "terminal.ansiYellow": "{{.reef4}}",
    "terminal.ansiBlue": "{{.sea4}}",
    "terminal.ansiMagenta": "{{.anemone4}}",
    "terminal.ansiCyan": "{{.biolume4}}",
    "terminal.ansiWhite": "{{.foam4}}",
    "terminal.ansiBrightBlack": "{{.abyss5}}",
    "terminal.ansiBrightRed": "{{.reef3}}",
    "terminal.ansiBrightGreen": "{{.emerald4}}",
    "terminal.ansiBrightYellow": "{{.reef4}}",
    "terminal.ansiBrightBlue": "{{.sea5}}",
    "terminal.ansiBrightMagenta": "{{.anemone4}}",
    "terminal.ansiBrightCyan": "{{.biolume4}}",
    "terminal.ansiBrightWhite": "{{.foam5}}",
