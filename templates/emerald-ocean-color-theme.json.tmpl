    "debugIcon.breakpointForeground": "{{.reef3}}",
    "editor.stackFrameHighlightBackground": "{{.biolume1}}",
    "textLink.foreground": "{{.sea5}}",
    "textLink.activeForeground": "{{.emerald4}}",
    "textPreformat.foreground": "{{.foam5}}",
    "textBlockQuote.background": "{{.abyss2}}",
    "textBlockQuote.border": "{{.abyss5}}"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "{{.foam2}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "TODO",
      "scope": [
        "comment.line.todo",
        "keyword.todo"
      ],
      "settings": {
        "foreground": "{{.reef4}}"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "{{.foam5}}"
      }
    },
    {
      "name": "Escapes and format verbs",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp",
        "punctuation.definition.template-expression",
        "constant.character.format"
      ],
      "settings": {
        "foreground": "{{.biolume4}}"
      }
    },
    {
      "name": "Numbers, booleans, nil, constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "{{.foam5}}"
      }
    },
    {
      "name": "Keywords and builtin types",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type.primitive",
        "support.type.builtin",
        "variable.language"
      ],
      "settings": {
        "foreground": "{{.emerald4}}"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "{{.foam3}}"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "{{.emerald4}}"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "{{.lagoon4}}"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "{{.foam5}}"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "{{.foam5}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Fields and properties",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "meta.property",
        "support.variable.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "{{.sea5}}"
      }
    },
    {
      "name": "Packages and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "entity.name.import",
        "support.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "{{.sea4}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Macros, attributes, decorators",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "{{.anemone4}}"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "{{.lagoon4}}"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "{{.sea5}}"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "{{.emerald4}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": null
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": null
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "{{.sea5}}"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "{{.foam2}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list",
        "markup.list"
      ],
      "settings": {
        "foreground": "{{.emerald4}}"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "{{.emerald4}}"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "{{.reef3}}"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "{{.sea5}}"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{{.reef3}}"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "{{.sea4}}",
      "italic": true
    },
    "type": "{{.lagoon4}}",
    "class": "{{.lagoon4}}",
    "struct": "{{.lagoon4}}",
    "interface": "{{.lagoon4}}",
    "enum": "{{.lagoon4}}",
    "typeParameter": "{{.lagoon4}}",
    "type.defaultLibrary": "{{.emerald4}}",
    "parameter": {
      "foreground": "{{.foam5}}",
      "italic": true
    },
    "variable": "{{.foam5}}",
    "property": "{{.sea5}}",
    "property.declaration": "{{.foam5}}",
    "property.definition": "{{.foam5}}",
    "enumMember": "{{.foam5}}",
    "function": "{{.emerald4}}",
    "method": "{{.emerald4}}",
    "macro": "{{.anemone4}}",
    "decorator": "{{.anemone4}}",
    "keyword": "{{.emerald4}}",
    "comment": {
      "foreground": "{{.foam2}}",
      "italic": true
    },
    "string": "{{.foam5}}",
    "number": "{{.foam5}}",
    "operator": "{{.foam3}}"
  }
}
