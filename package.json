{
  "name": "emerald-ocean",
  "displayName": "Emerald Ocean",
  "description": "A dark theme coloured like the ocean when green beats blue.",
  "version": "0.4.0",
  "publisher": "emerald-ocean",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emerald-ocean/emerald-ocean-vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "dark",
    "green",
    "emerald",
    "ocean",
    "theme"
  ],
  "galleryBanner": {
    "color": "#01130b",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Emerald Ocean",
        "uiTheme": "vs-dark",
        "path": "./themes/emerald-ocean-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "json-in-strings.injection",
        "path": "./syntaxes/json-in-strings.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ]
      },
      {
        "scopeName": "format-specifiers.injection",
        "path": "./syntaxes/format-specifiers.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ]
      },
      {
        "scopeName": "struct-tags.injection",
        "path": "./syntaxes/struct-tags.tmLanguage.json",
        "injectTo": [
          "source.go"
        ]
      },
      {
        "scopeName": "route-placeholders.injection",
        "path": "./syntaxes/route-placeholders.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx",
          "source.go"
        ]
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  }
}
